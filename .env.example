# =====================================================================
#  Copia este archivo a .env y cambia los valores:   cp .env.example .env
#  ¡NUNCA subas el .env real al repositorio! (está en .gitignore)
# =====================================================================

# ---------- Base de datos (PostgreSQL 16) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=app
# Puerto del HOST donde se publica Postgres (útil para correr las pruebas del backend desde tu máquina).
# Se usa 5433 para no chocar con un Postgres local en 5432.
DB_HOST_PORT=5433
# Interfaz donde se publica (en producción 127.0.0.1 para no exponerla a Internet)
DB_BIND_ADDRESS=0.0.0.0

# ---------- Backend (API Express) ----------
NODE_ENV=production
PORT=3000
# Secreto para firmar los JWT. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
LOG_LEVEL=info
# Orígenes permitidos por CORS (coma separada). En docker-compose el frontend usa el proxy de nginx, así que no hace falta.
CORS_ORIGIN=*

# Usuario administrador inicial (se crea al arrancar si no existe)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# ---------- Frontend (nginx) ----------
# Puerto del HOST donde se publica la app web
FRONTEND_PORT=8080

# ---------- Observabilidad (OpenTelemetry -> OpenObserve) ----------
# Si OTEL_EXPORTER_OTLP_ENDPOINT está vacío, la API funciona igual y NO envía telemetría.
# OpenObserve Cloud:  https://api.openobserve.ai/api/<tu_organizacion>
# OpenObserve local:  http://openobserve:5080/api/default   (perfil "observability" del docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Cabecera de autenticación: Authorization=Basic%20<base64("usuario:contraseña")>
#   node -e "console.log(Buffer.from('usuario@correo.com:contraseña').toString('base64'))"
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=pruebas-final-backend
# Intervalo de exportación de métricas en ms
OTEL_METRIC_EXPORT_INTERVAL=15000

# Credenciales del OpenObserve local (solo perfil "observability").
# Si se definen y OTEL_EXPORTER_OTLP_HEADERS está vacío, el backend arma solo la cabecera Basic.
ZO_ROOT_USER_EMAIL=root@example.com
ZO_ROOT_USER_PASSWORD=Complexpass#123
# Endpoint del OTel Collector (usa la red del host) y frecuencia de las sondas
OO_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
HOSTMETRICS_INTERVAL=30s
THERMAL_PROBE_INTERVAL=60
# Para producción ver .env.production.example
