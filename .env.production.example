# =====================================================================
#  Variables de PRODUCCIÓN (EC2). En el servidor:
#     cp .env.production.example .env      (o usa scripts/prepare-production-env.sh)
#  y reemplaza TODOS los valores marcados con CAMBIAR.
#  ¡NUNCA subas el .env real al repositorio!
# =====================================================================

# Levanta también OpenObserve + OTel Collector + sonda de temperatura con un simple
# "docker compose up -d" (equivale a --profile observability).
COMPOSE_PROFILES=observability

# ---------- Base de datos ----------
POSTGRES_USER=postgres
# IMPORTANTE: si la BD ya existe, usa la MISMA contraseña con la que se creó el volumen.
POSTGRES_PASSWORD=CAMBIAR-clave-postgres
POSTGRES_DB=app
# Solo accesible desde la propia EC2 (no se publica a Internet)
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=5433

# ---------- Backend ----------
NODE_ENV=production
PORT=3000
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (o: openssl rand -hex 48)
JWT_SECRET=CAMBIAR-secreto-jwt-largo-y-aleatorio
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
LOG_LEVEL=info
CORS_ORIGIN=*

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR-clave-admin

# ---------- Frontend ----------
FRONTEND_PORT=8080

# ---------- OpenObserve (mismo servidor, puerto 5080) ----------
# Credenciales del usuario administrador de OpenObserve. Se crean en el PRIMER arranque;
# cambiarlas aquí después no cambia la contraseña ya guardada (hay que hacerlo en la UI).
# Son las mismas que van en los secrets OPENOBSERVE_USER / OPENOBSERVE_PASSWORD de GitHub.
ZO_ROOT_USER_EMAIL=CAMBIAR@correo.com
ZO_ROOT_USER_PASSWORD=CAMBIAR-clave-openobserve
# Días que se conservan logs/métricas/trazas
ZO_RETENTION_DAYS=15
# Límite de memoria del contenedor de OpenObserve (la EC2 tiene 2 GB)
OPENOBSERVE_MEMORY_LIMIT=768M

# ---------- Telemetría del backend ----------
# El backend envía trazas, métricas y logs al OpenObserve LOCAL por la red interna de Docker.
# La autenticación se arma sola con ZO_ROOT_USER_EMAIL / ZO_ROOT_USER_PASSWORD.
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=pruebas-final-backend
OTEL_METRIC_EXPORT_INTERVAL=15000

# ---------- Monitoreo del host ----------
# El Collector usa la red del host, por eso apunta al puerto publicado en 127.0.0.1
OO_OTLP_ENDPOINT=http://127.0.0.1:5080/api/default
HOSTMETRICS_INTERVAL=30s
THERMAL_PROBE_INTERVAL=60
